%% Source snapshot: 2026-10-28. Based on source code, not a proposed architecture.
%% goalagent/{runner,contracts,provider,music,report,audit,fork}.py
%% goals/music.json; scorebench/{run,evaluate,metrics}.py
%% Solid arrows: control or data flow. Dotted arrows: support or persistence.
%% Recognition receives pixels or prior predictions, not reference transcription content.
%% Integrity checks hash both images and references; this is not an OS isolation claim.
flowchart TB
  goal["Goal + acceptance + budgets
goals/music.json"]

  subgraph host["1 · Host-controlled decision loop · goalagent/runner.py"]
    entry["AgentRunner
Load or resume state; acquire run.lock"]
    budget{"Step, time and
model-call budget available?"}
    controller["Single controller · CodexProvider
Goal + observations + remaining budget
One JSON tool decision; model tools disabled"]
    validate["Validate action · contracts.py + runner.py
Registered tool; observed evidence IDs
Experiment prerequisites + budget + hypothesis"]
    pending["Persist pending decision
Then execute on host"]
    observation["Record observation or error
Update evidence IDs and history"]
    entry --> budget
    budget -->|Yes| controller
    controller --> validate
    validate -->|Valid| pending
    validate -->|Invalid decision| observation
    observation -->|If still running| budget
  end
  goal --> entry

  subgraph domain["2 · Music domain adapter · goalagent/music.py"]
    route{"Selected tool"}
    research["inspect_dataset · baseline_summary
discover_evidence · read_evidence
Curated local catalog; no live web search"]
    experiment["run_experiment
Fixed sample subset; config-derived ID
Reuse receipts and completed sample traces"]
    vision["vision_kern
Codex vision call per image
Editable **kern + **mxhm"]
    harmony["audiveris_text_harmony
Promote chord-shaped OCR words
Existing enlarged Audiveris output"]
    preprocess["audiveris_preprocess
Scale + pad images
Run Audiveris again"]
    predictions[("Saved predictions + hashes
Per-sample traces; experiment receipt")]
    evaluate["evaluate_experiment
Parse / render in worker; score sequences
Check kern transposition; compare paired baselines"]
    route -->|Evidence tools| research
    route -->|Experiment| experiment
    experiment -->|Choose one| vision & harmony & preprocess
    vision & harmony & preprocess --> predictions
    route -->|Evaluation requested separately| evaluate
    predictions --> evaluate
  end
  pending --> route
  research --> observation
  predictions -->|Execution receipt| observation
  evaluate -->|Scores + limitations| observation

  subgraph finishGroup["3 · Host decides completion · contracts.success_gate"]
    gate["finish: select an evaluated experiment
Require 32 parseable samples; zero melody/chord errors
Zero transposition failures; audited timing; musician acceptance"]
    terminal["Terminal status
succeeded / goal_unmet / budget_exhausted"]
    report["report.html
Written on stop / checkpoint"]
    gate --> terminal
    terminal --> report
  end
  route -->|finish| gate
  budget -->|No| terminal
  gate -->|Final observation| observation

  subgraph support["4 · Local data, durability and review"]
    inputs[("research/manifest.json + score images
research/recent-talks/review.json
runs/first-benchmark/results.json")]
    labels[("Reference .krn labels
Transcription content read by evaluator")]
    state[("runs/RUN_ID/state.json + steps/
Atomic writes; history; budgets; pending action
Resume pending work without a new decision")]
    audit["goalagent.audit
Check citations, budgets, hashes and gate
Write agent-evaluation.json"]
    fork["goalagent.fork · manual correction workflow
Copy completed run; retain history + spent budget
Invalidate evaluations; add correction evidence"]
  end
  inputs -.-> research
  inputs -.-> experiment
  labels --> evaluate
  pending -.-> state
  observation -.-> state
  state -.->|Resume pending action| pending
  state -.-> report
  state -.-> audit
  state -.-> fork
  fork -.->|New run directory| entry

  scope["Current default: 7-song pilot · 12 steps · 2 experiments · 26 model calls · 30 active minutes
Evaluate each experiment before another. Current evaluator sets timing audit and musician acceptance to false.
The default pilot cannot pass the full completion gate."]
  goal -.-> scope

