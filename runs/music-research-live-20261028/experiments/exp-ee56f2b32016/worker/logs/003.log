# Serialize only actual MusicXML events. Reject overlapping/polyphonic results instead of inventing melody.
def reciprocal(q):
 q=Fraction(q).limit_denominator(4096)
 if q<=0:raise ValueError('Nonpositive duration')
 for dots in range(4):
  factor=Fraction(2**(dots+1)-1,2**dots)
  r=4*factor/q
  if r.denominator==1 and r>0:return str(r.numerator)+'.'*dots
 r=4/q
 return str(r.numerator)+'%'+str(r.denominator)
def pitch_token(p):
 octv=p.octave
 if octv is None:raise ValueError('Missing octave')
 s=p.step.lower()*(octv-3) if octv>=4 else p.step.upper()*(4-octv)
 a=p.accidental.alter if p.accidental else 0
 if a!=int(a):raise ValueError('Microtonal pitch unsupported')
 return s+('#'*int(a) if a>0 else '-'*int(-a))
def token(n):
 if n.duration.isGrace:raise ValueError('Grace event requires explicit handling')
 s=reciprocal(n.duration.quarterLength)
 if n.isRest:return s+'r'
