 report['serializer_audit']={'source_retained':'parent_chord_ocr.py','finding':'A syntax-only row check and a synthetic melody parse do not validate complete generated files. Missing baseline melody must be treated as recognition failure; null-only melody cannot demonstrate a parsed transcription. Exact protected-reader failure is unavailable.'}
 try:
