# Serialize only actual MusicXML events. Reject overlapping/polyphonic results instead of inventing melody.
def reciprocal(q):
 q=Fraction(q).limit_denominator(4096)
 if q<=0:raise ValueError('Nonpositive duration')
 for dots in range(4):
  factor=Fraction(2**(dots+1)-1,2**dots)
  r=4*factor/q
  if r.denominator==1 and r>0:return str(r.numerator)+'.'*dots
 r=4/q
 return str(r.numerator)+'%'+str(r.denominator)
def pitch_token(p):
 octv=p.octave
 if octv is None:raise ValueError('Missing octave')
 s=p.step.lower()*(octv-3) if octv>=4 else p.step.upper()*(4-octv)
 a=p.accidental.alter if p.accidental else 0
 if a!=int(a):raise ValueError('Microtonal pitch unsupported')
 return s+('#'*int(a) if a>0 else '-'*int(-a))
def token(n):
 if n.duration.isGrace:raise ValueError('Grace event requires explicit handling')
 s=reciprocal(n.duration.quarterLength)
 if n.isRest:return s+'r'
 if isinstance(n,chord.Chord):raise ValueError('Polyphonic recognized chord: melody selection unaudited')
 s+=pitch_token(n.pitch)
 if n.tie:s={'start':'[','continue':'_','stop':']'}[n.tie.type]+s if n.tie.type=='start' else s+{'continue':'_','stop':']'}[n.tie.type]
 return s
harm=re.compile(r'^[A-G](?:#|b)?:(?:maj|min|7|maj7|min7|min6|dim7|sus4|add9)(?:/[A-G](?:#|b)?)?$')
def old_harmonies(name):
 ans=[]
 for row in old.get(name,'').splitlines():
  cells=row.split('\t')
  if len(cells)==2 and harm.fullmatch(cells[1]):ans.append(cells[1])
 return ans
pcs=dict(zip('CDEFGAB',[0,2,4,5,7,9,11]));names=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B']
def pc(s):return (pcs[s[0]]+s.count('#')-s.count('b'))%12
def transpose_h(h):
 root,tail=h.split(':');parts=tail.split('/');out=names[(pc(root)+2)%12]+':'+parts[0]
 if len(parts)==2:out+='/'+names[(pc(parts[1])+2)%12]
 return out
