"""Conservative image-only chord OCR; optional fixed Audiveris kern input.
Run: PYTHONPATH=/workspace/vendor python main.py --baseline-dir baseline
Missing baseline is reported, never replaced with invented melody.
"""
import argparse,csv,hashlib,io,json,os,re,subprocess
from pathlib import Path
from PIL import Image

QUAL={'':'maj','m':'min','min':'min','7':'7','maj7':'maj7','M7':'maj7','m7':'min7','min7':'min7','m6':'min6','min6':'min6','dim7':'dim7','sus4':'sus4','add9':'add9'}
GRAM=re.compile(r'^([A-G](?:#|b)?)(maj7|min7|min6|dim7|sus4|add9|M7|m7|m6|min|m|7)?(?:/([A-G](?:#|b)?))?$')
HARM=re.compile(r'^([A-G](?:#|b)?):(maj|min|7|maj7|min7|min6|dim7|sus4|add9)(?:/([A-G](?:#|b)?))?$')
def parse_chord(s):
    s=s.replace('♭','b').replace('♯','#')
    m=GRAM.fullmatch(s)
    if not m:return None
    root,q,bass=m.groups()
    return root+':'+QUAL[q or '']+('/'+bass if bass else '')
def format_chord(s):
    m=HARM.fullmatch(s)
    if not m:raise ValueError(s)
    root,q,bass=m.groups()
    inv={'maj':'','min':'m','7':'7','maj7':'maj7','min7':'m7','min6':'m6','dim7':'dim7','sus4':'sus4','add9':'add9'}
    return root+inv[q]+('/'+bass if bass else '')
NAMES=['C','C#','D','D#','E','F','F#','G','G#','A','A#','B']
PCS=dict(zip('CDEFGAB',[0,2,4,5,7,9,11]))
def pc(s):return (PCS[s[0]]+s.count('#')-s.count('b'))%12
def transpose(s,n):
    m=HARM.fullmatch(s)
    if not m:raise ValueError(s)
    r,q,b=m.groups()
    return NAMES[(pc(r)+n)%12]+':'+q+('/'+NAMES[(pc(b)+n)%12] if b else '')
def structural_check(text):
    rows=[x for x in text.splitlines() if x and not x.startswith('!!')]
    assert rows[0]=='**kern\t**mxhm'
    assert rows[-1]=='*-\t*-'
    for row in rows:
        a,b=row.split('\t')
        if not b.startswith(('*','!','=')) and b!='.':assert HARM.fullmatch(b),b
    return True

def main():
    ap=argparse.ArgumentParser();ap.add_argument('--baseline-dir',default='baseline');args=ap.parse_args()
    out=Path('output');out.mkdir(exist_ok=True);diag=Path('diagnostics');diag.mkdir(exist_ok=True)
    root=Path('/workspace/tmp/ocr-root');exe=str(root/'usr/bin/tesseract')
    env=os.environ.copy();env['LD_LIBRARY_PATH']=str(root/'usr/lib/aarch64-linux-gnu')+':'+env.get('LD_LIBRARY_PATH','');env['TESSDATA_PREFIX']=str(root/'usr/share/tesseract-ocr/5/tessdata')
    tests={'type':'synthetic software checks, not transcription accuracy'}
    for c in ['C','Bb','F#m7/C#','Dm/C','Fmaj7','G7','Adim7','Dsus4','Eadd9','Am6']:
        h=parse_chord(c);assert h and parse_chord(format_chord(h))==h
        for n in range(-12,13):
            t=transpose(h,n);a=HARM.fullmatch(h);b=HARM.fullmatch(t)
            assert pc(b[1])==(pc(a[1])+n)%12 and b[2]==a[2]
            if a[3]:assert pc(b[3])==(pc(a[3])+n)%12
    for c in ['Am/','Fmaj’','G’','C9','C13','H','Fm°/C','CC.']:assert parse_chord(c) is None
    tests['chord_roundtrip_and_root_slash_transposition']='passed'
    try:
        from music21 import converter
        synthetic='**kern\n*clefG2\n*M4/4\n=1\n4c\n8d\n8e\n4r\n4g\n==\n*-\n'
        score=converter.parseData(synthetic,format='humdrum');notes=list(score.recurse().notes)
        assert len(notes)==4
        for n in [-5,2,12]:
            shifted=score.transpose(n)
            for a,b in zip(notes,shifted.recurse().notes):assert b.pitch.midi-a.pitch.midi==n and b.duration.quarterLength==a.duration.quarterLength
        tests['synthetic_kern_parse_and_melody_transposition']='passed'
    except Exception as e:tests['synthetic_kern_parse_and_melody_transposition']='failed: '+repr(e)
    reports=[]
    for src in sorted(Path('inputs').glob('sample-*.png')):
        im=Image.open(src);crop=diag/(src.stem+'-chord-crop.png')
        if not crop.exists():
            im.crop((0,0,im.width,max(1,int(im.height*.30)))).resize((im.width*4,max(1,int(im.height*.30))*4)).save(crop)
        scale=Image.open(crop).width/im.width
        d={'image':str(src),'crop':str(crop),'crop_scale':scale,'timing':'unaudited','ocr_failures':[],'unsupported_or_unrecognized':[],'accepted':[],'alignment':[]}
        candidates=[]
        for psm in [6,11]:
            try:
                p=subprocess.run([exe,str(crop),'stdout','--psm',str(psm),'tsv'],env=env,capture_output=True,text=True,timeout=15)
                (diag/(src.stem+f'-psm{psm}.tsv')).write_text(p.stdout)
                if p.returncode:d['ocr_failures'].append({'psm':psm,'error':p.stderr[-1500:]});continue
                for row in csv.DictReader(io.StringIO(p.stdout),delimiter='\t'):
                    word=(row.get('text') or '').strip()
                    if not word:continue
                    conf=float(row['conf']);box=[int(row[k])/scale for k in ['left','top','width','height']]
                    h=parse_chord(word)
                    item={'text':word,'confidence':conf,'bbox_original_pixels':box,'psm':psm,'harmony':h}
                    if h and conf>=65:candidates.append(item)
                    else:
                        item['reason']='low_confidence' if h else ('unsupported_or_malformed_chord_syntax' if re.match('^[A-G]',word) else 'unrecognized_text_or_nonchord')
                        d['unsupported_or_unrecognized'].append(item)
            except Exception as e:d['ocr_failures'].append({'psm':psm,'error':repr(e)})
        clusters=[]
        for item in sorted(candidates,key=lambda x:x['bbox_original_pixels'][0]):
            x=item['bbox_original_pixels'][0]
            match=next((g for g in clusters if abs(g[0]['bbox_original_pixels'][0]-x)<8),None)
            if match is None:clusters.append([item])
            else:match.append(item)
        for group in clusters:
            if len({v['harmony'] for v in group})>1:
                d['unsupported_or_unrecognized'].append({'reason':'conflicting_OCR_readings','candidates':group});continue
            best=max(group,key=lambda v:v['confidence']);best['supporting_psms']=sorted({v['psm'] for v in group});d['accepted'].append(best)
        baseline=Path(args.baseline_dir)/(src.stem+'.krn')
        if baseline.exists():
            original=baseline.read_text();rows=original.splitlines();header=next(i for i,r in enumerate(rows) if r.startswith('**'))
            spines=rows[header].split('\t');ki=spines.index('**kern')
            assert len(spines)==2 and spines[1]=='**mxhm' and ki==0,'Expected fixed two-spine baseline'
            events=[i for i,r in enumerate(rows) if r and not r.startswith(('!','*','=')) and r.split('\t')[0]!='.']
            taken=set()
            for item in d['accepted']:
                if not events:break
                frac=min(1,max(0,item['bbox_original_pixels'][0]/im.width));ei=round(frac*(len(events)-1));idx=events[ei]
                d['alignment'].append({'bbox':item['bbox_original_pixels'],'proposed_event_index':ei,'uncertain':True,'method':'proportional horizontal position; no note geometry','applied':False})
                # Do not override baseline harmony or resolve timing collisions silently.
                fields=rows[idx].split('\t')
                if fields[1]=='.' and idx not in taken:
                    fields[1]=item['harmony'];rows[idx]='\t'.join(fields);taken.add(idx);d['alignment'][-1]['applied']=True
            before=[r.split('\t')[0] for r in original.splitlines() if r and not r.startswith('!!')]
            after=[r.split('\t')[0] for r in rows if r and not r.startswith('!!')]
            assert before==after
            d['melody_preserved']=True;d['baseline_sha256']=hashlib.sha256(original.encode()).hexdigest()
            text='\n'.join(rows)+'\n'
        else:
            d['melody_preserved']=None;d['blocking_failure']='Enlarged Audiveris baseline unavailable; melody not transcribed. Output is an incomplete harmony-only container, not a complete prediction.'
            rows=['!! INCOMPLETE: fixed Audiveris melody unavailable; chord timing unaudited','**kern\t**mxhm']
            for item in d['accepted']:
                rows.append('.\t'+item['harmony'])
                d['alignment'].append({'bbox':item['bbox_original_pixels'],'proposed_event_index':None,'uncertain':True,'method':'left-to-right order only; no musical onset assigned','applied':False})
            rows.append('*-\t*-');text='\n'.join(rows)+'\n'
        (out/(src.stem+'.krn')).write_text(text)
        try:d['two_spine_structural_check']=structural_check(text)
        except Exception as e:d['two_spine_structural_check']=repr(e)
        try:
            from music21 import converter
            parsed=converter.parseData(text,format='humdrum')
            d['music21_parse']={'passed':True,'melody_note_or_rest_count':len(list(parsed.recurse().notesAndRests)),'limitation':'Parser acceptance does not validate mxhm semantics or transcription completeness'}
        except Exception as e:d['music21_parse']={'passed':False,'error':repr(e)}
        (diag/(src.stem+'.json')).write_text(json.dumps(d,indent=2));reports.append(d)
    report={'status':'goal unmet','tests':tests,'images':len(reports),'outputs':len(reports),'accepted_OCR_chords':sum(len(d['accepted']) for d in reports),'missing_baselines':sum(d['melody_preserved'] is None for d in reports),'baseline_reported_metrics':{'chord_errors':30,'chord_matches':8,'melody_errors':87,'melody_reference_count':130},'new_measured_transcription_metrics':None,'comparison':'Unavailable: no protected scorer or reference labels; accepted OCR count is not correct matches. Missing baseline prevents melody non-regression verification.','timing':'unaudited','release':'Not ready; incomplete melody outputs must count as failures.'}
    (diag/'report.json').write_text(json.dumps(report,indent=2));print(json.dumps(report,indent=2))
if __name__=='__main__':main()
